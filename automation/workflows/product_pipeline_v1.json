        0,
        300
      ],
      "webhookId": "risheh-product"
    },
    {
      "parameters": {
        "jsCode": "// Single entry webhook for all product.* outbox events (see app/outbox_worker.py).\nconst secret = $json.headers?.['x-automation-secret'];\nif (!secret || secret !== $env.RISHEH_AUTOMATION_SECRET) throw new Error('invalid automation secret');\nconst e = $json.body ?? $json;\nconst allowed = ['product.content.generate.requested', 'product.wordpress.publish.requested', 'product.notify.fanout.requested'];\nif (!allowed.includes(e.event_type)) throw new Error('unsupported event type: ' + e.event_type);\nif (!e.payload) throw new Error('missing payload');\nreturn [{ json: {\n  event_type: e.event_type,\n  event_id: e.event_id,\n  workspace_id: e.workspace_id ?? e.payload.workspace_id,\n  correlation_id: e.correlation_id ?? null,\n  payload: e.payload\n} }];"
      },
      "id": "07799dba-54a5-4df9-8ff5-9ddb6e03d37c",
      "name": "Validate Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.event_type }}",
                    "rightValue": "product.content.generate.requested",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "generate"
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.event_type }}",
                    "rightValue": "product.wordpress.publish.requested",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "wordpress"
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.event_type }}",
                    "rightValue": "product.notify.fanout.requested",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "notify"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
