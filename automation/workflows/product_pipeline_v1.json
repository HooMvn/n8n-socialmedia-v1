      "id": "c47cd44b-e4da-481d-88e0-8c74b10efb25",
      "name": "Generate Draft (API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        40
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nif (body.detail && !body.job) {\n  // 4xx/5xx handled by API state machine already (job -> failed/needs_attention). Log & accept.\n  return [{ json: { job_status: null, error: JSON.stringify(body.detail).slice(0, 500) } }];\n}\nreturn [{ json: { job_status: body.job?.status ?? null, version_id: body.version?.id ?? null, auto_publish: body.auto_publish ?? false } }];"
      },
      "id": "b40eb4e2-1185-4185-8a0b-88ed2896c27e",
      "name": "Check Generate Result",
