      "parameters": {
        "method": "POST",
        "url": "={{ $env.RISHEH_API_BASE_URL }}/api/v1/workspaces/{{ $json.workspace_id }}/products/jobs/{{ $json.payload.job_id }}/generate-draft",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-automation-secret",
              "value": "={{ $env.RISHEH_AUTOMATION_SECRET }}"
