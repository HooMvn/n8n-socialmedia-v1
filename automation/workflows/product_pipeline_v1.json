        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ instruction: $json.payload.instruction ?? 'این محصول را به‌صورت یک پست وبلاگ فارسی، صادقانه و فقط بر اساس داده ارائه‌شده معرفی کن.' }) }}",
        "options": {
