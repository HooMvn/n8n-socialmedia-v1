    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, stage: 'generate', job_status: $json.job_status, error: $json.error ?? null }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "14389de3-1e18-438e-9816-a1a9f6b5d975",
      "name": "Accepted (Generate)",
